<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background for dawn: deep blue with a warm glow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#4A3D78"
                android:centerColor="#1F2858"
                android:endColor="#0B1433" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.92"
                android:centerY="0.0"
                android:gradientRadius="90%"
                android:startColor="#5CF4A26B"
                android:endColor="#00000000"
                android:type="radial" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/widget_star"
        android:gravity="top|end" />
    <item>
        <shape>
            <stroke android:width="1dp" android:color="@color/card_stroke" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
</layer-list>