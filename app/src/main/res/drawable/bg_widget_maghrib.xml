<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background for dusk: plum with a sunset glow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#5A2840"
                android:centerColor="#2E1534"
                android:endColor="#120A1D" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.92"
                android:centerY="0.0"
                android:gradientRadius="90%"
                android:startColor="#45F08A5D"
                android:endColor="#00000000"
                android:type="radial" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/widget_star"
        android:gravity="top|end" />
    <item>
        <shape>
            <stroke android:width="1dp" android:color="@color/card_stroke" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
</layer-list>