<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rabat" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_bottom</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorControlActivated">@color/gold</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
    </style>

    <style name="SettingsAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:buttonTint">@color/gold</item>
        <!-- Keep "English" beside its button in the Arabic layout too. -->
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
