<?xml version="1.0" encoding="utf-8"?>
<!-- Large (4x2 and up): the next prayer with a progress ring and live countdown, then the day as a
     timeline. Default texts are only for the widget picker preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_crescent" />

        <TextView
            android:id="@+id/w_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:text="Rabat · Mon 2 Nov"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp">

        <FrameLayout
            android:id="@+id/w_ring_box"
            android:layout_width="52dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/w_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ring_preview" />

            <ImageView
                android:id="@+id/w_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dhuhr"
                android:tint="@color/gold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_next_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Dhuhr"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/w_next_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="at 12:16"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:gravity="end"
            android:orientation="vertical">

            <Chronometer
                android:id="@+id/w_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:countDown="true"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/gold"
                android:textDirection="ltr"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/w_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/remaining"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- The day: a gold line runs from dot to dot as the day passes. -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ProgressBar
                    android:id="@+id/w_timeline"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="10"
                    android:indeterminate="false"
                    android:max="1000"
            android:mirrorForRtl="true"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progress="450"
                    android:progressDrawable="@drawable/widget_bar" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/w_col_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp">

                    <FrameLayout
                        android:layout_width="16dp"
                        android:layout_height="16dp">

                        <ImageView
                            android:id="@+id/w_dot_0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_dot_past" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/w_col_name_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:text="Fajr"
                        android:textColor="@color/text_faint"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/w_col_time_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="05:18"
                        android:textColor="@color/text_faint"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/w_col_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp">

                    <FrameLayout
                        android:layout_width="16dp"
                        android:layout_height="16dp">

                        <ImageView
                            android:id="@+id/w_dot_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_dot_past" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/w_col_name_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:text="Sunrise"
                        android:textColor="@color/text_faint"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/w_col_time_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="06:45"
                        android:textColor="@color/text_faint"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/w_col_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_widget_col_active"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp">

                    <FrameLayout
                        android:layout_width="16dp"
                        android:layout_height="16dp">

                        <ImageView
                            android:id="@+id/w_dot_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_dot_active" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/w_col_name_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:text="Dhuhr"
                        android:textColor="@color/gold"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/w_col_time_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="12:16"
                        android:textColor="@color/gold"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/w_col_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp">

                    <FrameLayout
                        android:layout_width="16dp"
                        android:layout_height="16dp">

                        <ImageView
                            android:id="@+id/w_dot_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_dot_future" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/w_col_name_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:text="Asr"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/w_col_time_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="15:12"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/w_col_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp">

                    <FrameLayout
                        android:layout_width="16dp"
                        android:layout_height="16dp">

                        <ImageView
                            android:id="@+id/w_dot_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_dot_future" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/w_col_name_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:text="Maghrib"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/w_col_time_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="17:39"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/w_col_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp">

                    <FrameLayout
                        android:layout_width="16dp"
                        android:layout_height="16dp">

                        <ImageView
                            android:id="@+id/w_dot_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_dot_future" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/w_col_name_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:text="Isha"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/w_col_time_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="18:54"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
