<?xml version="1.0" encoding="utf-8"?>
<!-- A clearly gold track when on, so on and off read apart on the dark cards. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.55" android:color="@color/gold" android:state_checked="true" />
    <item android:alpha="0.35" android:color="@color/text_muted" />
</selector>
